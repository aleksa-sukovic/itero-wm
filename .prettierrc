{
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "printWidth": 160,
    "proseWrap": "always",
    "overrides": [
        {
            "files": ["*.md"],
            "options": {
                "proseWrap": "preserve"
            }
        }
    ]
}
